# === Frontend workspace ===
# Cada app (dashboard/booking/admin) tiene su propio .env.example; copialos a
# <app>/.env.local. Este archivo es solo referencia.
#
# URL interna del backend (SIEMPRE server-side; NUNCA usar el prefijo
# NEXT_PUBLIC). Incluye el prefijo /api/v1. Es obligatoria en las tres apps:
# no hay valor por defecto.
API_INTERNAL_URL=http://localhost:3000/api/v1

# Recordatorio para el .env del BACKEND (backend/api-agendox) en dev:
#   CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# En prod, dashboard y admin hablan con el backend solo server-side (BFF), así
# que no necesitan CORS. Booking tampoco: el browser siempre pega same-origin.
