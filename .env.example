# === Frontend workspace (FM0) ===
# Cada app (dashboard/booking) tiene su propio .env.example; copialos a .env.local.
#
# URL interna del backend (SIEMPRE server-side; NUNCA usar el prefijo NEXT_PUBLIC).
# Incluye el prefijo /api/v1. El health check deriva el origin de esta URL.
API_INTERNAL_URL=http://localhost:3000/api/v1

# Recordatorio para el .env del BACKEND (backend/api-agendox) en dev:
#   CORS_ORIGINS=http://localhost:3001,http://localhost:3002
